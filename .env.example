# Copy to .env.local for local development. Leave TURSO_* unset locally — the app
# then uses a SQLite file at data/routes.db.

# Production (Vercel): point these at a Turso database.
#   turso db create shareabouts
#   turso db show shareabouts --url        -> TURSO_DATABASE_URL
#   turso db tokens create shareabouts     -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Enables DELETE /api/routes/:id and the /admin moderation page. Without it,
# deletion is disabled. Use a long random string (e.g. `openssl rand -hex 32`).
ADMIN_TOKEN=

# Optional. Salt mixed into the hashed client IP used for rate limiting.
# Defaults to a build-time constant if unset.
RATE_LIMIT_SALT=

# Optional. Absolute URL of a hosted Boston Cyclists Union logo (e.g. a Vercel
# Blob URL). Used for the sidebar footer instead of the gitignored
# public/bcu-logo.jpg. If unset and no local file exists, the logo row is hidden.
NEXT_PUBLIC_BCU_LOGO_URL=
